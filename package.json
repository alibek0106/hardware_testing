{
  "name": "hardware_testing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:aqi": "playwright test --project=ui-aqicn",
    "test:api": "playwright test --project=api",
    "test:opcua": "playwright test --project=opcua",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "opcua:start": "docker compose up -d opcplc",
    "opcua:wait": "node scripts/wait-for-opcua.mjs",
    "opcua:logs": "docker compose logs opcplc",
    "opcua:stop": "docker compose down --remove-orphans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibek0106/hardware_testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alibek0106/hardware_testing/issues"
  },
  "homepage": "https://github.com/alibek0106/hardware_testing#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.5",
    "globals": "^17.7.0",
    "node-opcua": "^2.175.2",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
